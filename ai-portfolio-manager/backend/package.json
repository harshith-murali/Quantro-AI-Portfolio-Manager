{
  "name": "quantro-auth-backend",
  "version": "1.0.0",
  "description": "Production-grade JWT authentication backend for Quantro AI Portfolio Manager",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc --project tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost:5432/quantro_test ACCESS_TOKEN_SECRET=0123456789abcdef0123456789abcdef REFRESH_TOKEN_SECRET=abcdef0123456789abcdef0123456789 AWS_S3_BUCKET=test-bucket node -r ts-node/register -r tsconfig-paths/register --test src/**/*.test.ts",
    "pipeline": "ts-node -r tsconfig-paths/register src/scripts/runPipeline.ts",
    "pipeline:force": "ts-node -r tsconfig-paths/register src/scripts/runPipeline.ts --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@aws-sdk/client-s3": "^3.1047.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "winston": "^3.13.0",
    "yahoo-finance2": "^3.14.1",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.1",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
