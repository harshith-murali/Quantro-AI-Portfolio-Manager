# ─── Application ─────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://fintech_user:fintech_password@localhost:5432/fintech_db?schema=public"

# ─── JWT Secrets (generate with: openssl rand -base64 64) ─────────
ACCESS_TOKEN_SECRET=your-super-secret-access-token-secret-must-be-at-least-32-chars
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-secret-must-be-at-least-32-chars

# ─── JWT Expiry ───────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Security ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12

# ─── Redis (optional — for future token blacklisting/caching) ─────
# REDIS_URL=redis://localhost:6379
