# ─── Application ─────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://quantro_user:quantro_password@localhost:5432/quantro_db?schema=public"

# ─── JWT Secrets (generate with: openssl rand -base64 64) ─────────
ACCESS_TOKEN_SECRET=your-super-secret-access-token-secret-must-be-at-least-32-chars
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-secret-must-be-at-least-32-chars

# ─── JWT Expiry ───────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Security ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12

# ─── Redis (optional; app uses TTL-aware memory fallback if omitted) ─────
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── AWS S3 market data ───────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-market-data-bucket
MARKET_DATA_MAX_STALENESS_DAYS=10
# Latest execution/valuation prices: s3 for your own data lake, yahoo for public INR quotes.
MARKET_PRICE_PROVIDER=yahoo
# Educational simulation only: allow virtual orders outside exchange hours.
BYPASS_MARKET_HOURS=false

# ─── AI Advisor (Groq free plan by default) ──────────────────────
# Create a free key: https://console.groq.com/keys
# Free-plan quotas apply. Keep the Groq account on its Free plan.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional alternative providers: explicitly set AI_PROVIDER to
# huggingface, sagemaker, or anthropic. auto enables cross-provider fallback
# and may use paid services; groq never falls back to these providers.
# HF_API_KEY alone uses Hugging Face Inference Providers chat API.
HF_API_KEY=
HF_MODEL=Qwen/Qwen3-32B
# Optional dedicated text-generation endpoint (instead of hosted chat)
HF_ENDPOINT_URL=
SAGEMAKER_ENDPOINT_NAME=

# ─── Anthropic AI Advisor ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# Optional real email delivery; leave unset for interview sandbox.
# Recovery and verification return a clear unavailable response without these.
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_APP_URL=https://quantro-landing.vercel.app

# Historical backtests can read a validated, immutable Yahoo-origin S3 snapshot.
# Quote/valuation provider remains separately controlled by MARKET_PRICE_PROVIDER.
BACKTEST_DATA_PROVIDER=yahoo
BACKTEST_S3_MANIFEST_KEY=
